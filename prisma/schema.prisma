// Prisma schema for outbound account monitoring (direct business + enterprise).
// Runs on SQLite via the better-sqlite3 driver adapter — see src/lib/prisma.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// SQLite has no native enum support, so category/associate are plain strings
// validated against the fixed lists in src/lib/constants.ts.
model Business {
  id               String   @id @default(cuid())
  name             String
  category         String
  partnerAssociate String
  createdAt        DateTime @default(now())

  checkIns           CheckIn[]
  utilizationEntries UtilizationEntry[]

  @@index([category])
  @@index([partnerAssociate])
}

model CheckIn {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  checkInDate DateTime

  // How many outbound calls were actually recorded during this check-in period.
  recordingsCount Int
  // Time of day the rep is expected to start/stop recording, e.g. "09:00".
  startTime String
  stopTime  String
  // Expected recording hours, derived from startTime/stopTime minus the
  // lunch break — see computeExpectedHours in src/lib/hours.ts.
  expectedHours Float

  // Recording setup used: "MONO" or "MULTICAM".
  deviceType String

  whatWentWrong       String?
  whatNeedsImprovement String?

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([checkInDate])
}

// Device utilization entries for Outbound Monitoring businesses — separate
// from CheckIn. Hours are derived: deviceCount * (6 for MULTICAM, 4 for MONO)
// — see src/lib/utilization.ts.
model UtilizationEntry {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  date        DateTime
  deviceType  String
  deviceCount Int

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([date])
}

// Sales Monitoring is a separate tracking area from Outbound Monitoring —
// its own businesses, agents, and utilization entries.
model SalesBusiness {
  id         String   @id @default(cuid())
  name       String
  salesAgent String
  createdAt  DateTime @default(now())

  utilizationEntries SalesUtilizationEntry[]

  @@index([salesAgent])
}

model SalesUtilizationEntry {
  id         String        @id @default(cuid())
  businessId String
  business   SalesBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  date        DateTime
  deviceType  String
  deviceCount Int

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([date])
}

// Admin-visible log of every create/delete action across both monitoring
// areas — see src/lib/audit.ts.
model AuditLogEntry {
  id         String   @id @default(cuid())
  action     String // "CREATE" | "DELETE"
  entityType String
  entityId   String
  summary    String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
