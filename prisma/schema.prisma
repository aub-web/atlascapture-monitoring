// Prisma schema for outbound account monitoring (direct business + enterprise).
// Runs on Postgres (Neon) via the pg driver adapter — see src/lib/prisma.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// The roster of Outbound partner associates — see
// src/lib/actions/partner-associate-actions.ts. Business.partnerAssociate
// stores the name as a plain string rather than a foreign key, so removing
// an associate here never breaks a business record that already used it.
model PartnerAssociate {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// category is a plain string validated against the fixed list in
// src/lib/constants.ts.
model Business {
  id               String   @id @default(cuid())
  name             String
  category         String
  partnerAssociate String
  // "ACTIVE" | "INACTIVE" — see src/lib/constants.ts.
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())

  checkIns           CheckIn[]
  utilizationEntries UtilizationEntry[]

  @@index([category])
  @@index([partnerAssociate])
  @@index([status])
}

model CheckIn {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  checkInDate DateTime

  // How many outbound calls were actually recorded during this check-in period.
  recordingsCount Int
  // Time of day the rep is expected to start/stop recording, e.g. "09:00".
  startTime String
  stopTime  String
  // Expected recording hours, derived from startTime/stopTime minus the
  // lunch break — see computeExpectedHours in src/lib/hours.ts.
  expectedHours Float

  // Recording setup used: "MONO" or "MULTICAM".
  deviceType String

  whatWentWrong       String?
  whatNeedsImprovement String?

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([checkInDate])
}

// Device utilization entries for Outbound Monitoring businesses — separate
// from CheckIn. Capacity hours are derived: deviceCount * (6 for MULTICAM, 4
// for MONO); recordedHours is the actual hours logged that day, entered by
// the user — see src/lib/utilization.ts.
model UtilizationEntry {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  date            DateTime
  deviceType      String
  deviceCount     Int
  recordedHours   Float    @default(0)
  recordingStatus String   @default("ACTIVELY_RECORDING")

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([date])
}

// The roster of Sales agents — see src/lib/actions/sales-agent-actions.ts.
// SalesBusiness.salesAgent stores the name as a plain string rather than a
// foreign key, so removing an agent here never breaks a business record
// that already used it.
model SalesAgent {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// Sales Monitoring is a separate tracking area from Outbound Monitoring —
// its own businesses, agents, and utilization entries.
model SalesBusiness {
  id         String   @id @default(cuid())
  name       String
  salesAgent String
  // "ACTIVE" | "INACTIVE" — see src/lib/constants.ts.
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())

  utilizationEntries SalesUtilizationEntry[]

  @@index([salesAgent])
  @@index([status])
}

model SalesUtilizationEntry {
  id         String        @id @default(cuid())
  businessId String
  business   SalesBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  date            DateTime
  deviceType      String
  deviceCount     Int
  recordedHours   Float    @default(0)
  remarks         String?
  recordingStatus String   @default("ACTIVELY_RECORDING")

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([date])
}

// Admin-visible log of every create/delete action across both monitoring
// areas — see src/lib/audit.ts.
model AuditLogEntry {
  id         String   @id @default(cuid())
  action     String // "CREATE" | "DELETE"
  entityType String
  entityId   String
  summary    String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
